# Supabase Project Settings → API. Only these public values reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production origin: https://autmail.vercel.app (no trailing slash or path).
NEXT_PUBLIC_APP_URL=

# Server-only key for protected configuration, security checks, and administration.
SUPABASE_SERVICE_ROLE_KEY=
# Admin credentials for the shared sign-in page. Server-only; never commit real values.
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
# Use a long, unique password. No hash script or separate admin signup is needed.

# Set NEXT_PUBLIC_APP_URL in Vercel to the production origin above, then redeploy.
# Browser connection Client/Tenant IDs are saved in AUTMAIL, not in this file.
# Optional metadata-reader setup is documented in docs/admin-microsoft-setup.md.
# Never commit actual credentials or prefix server secrets with NEXT_PUBLIC_.

# Optional scheduled sending. Setup: docs/scheduled-mail-setup.md
# Keep the same encryption key in Vercel and Supabase Edge Function secrets.
SCHEDULE_ENCRYPTION_KEY=
# Default registration's Client ID and client-secret Value; SERVER ONLY.
MICROSOFT_SCHEDULER_CLIENT_ID=
MICROSOFT_SCHEDULER_CLIENT_SECRET=
# SCHEDULE_WORKER_SECRET belongs in Supabase Edge Function secrets and Vault, not the browser.
